{
  "name": "interview-preparation-ai-frontend",
  "version": 2,
  "builds": [
    {
      "src": "frontend/interview-prep-ai/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/interview-prep-ai/dist/$1"
    }
  ]
}
