# =================================================================
# INTERVIEW PREPARATION AI - BACKEND ENVIRONMENT VARIABLES
# =================================================================
# Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!

# =================================================================
# SERVER CONFIGURATION
# =================================================================
PORT=8000

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
# MongoDB connection string - Get from MongoDB Atlas or local MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# =================================================================
# AUTHENTICATION & SECURITY
# =================================================================
# JWT Secret Key - Generate a strong random string
JWT_SECRET=your_jwt_secret_key_here

# =================================================================
# AI SERVICES API KEYS
# =================================================================
# Google Gemini AI API Key (Required for AI features)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional - for ChatGPT integration)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (Optional)
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Cohere API Key (Optional)
# Get from: https://dashboard.cohere.ai/api-keys
# COHERE_API_KEY=your_cohere_api_key_here

# =================================================================
# CLOUD STORAGE & SERVICES
# =================================================================
# AWS Credentials (Optional - for file storage)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET_NAME=your_bucket_name

# Cloudinary (Optional - for image storage)
# Get from: https://cloudinary.com/users/register_free
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =================================================================
# EMAIL SERVICES
# =================================================================
# SendGrid (Optional - for email notifications)
# Get from: https://sendgrid.com/
# SENDGRID_API_KEY=your_sendgrid_api_key
# FROM_EMAIL=noreply@yourapp.com

# Gmail SMTP (Alternative email service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password

# =================================================================
# EXTERNAL APIS & INTEGRATIONS
# =================================================================
# LinkedIn API (Optional - for profile integration)
# Get from: https://www.linkedin.com/developers/
# LINKEDIN_CLIENT_ID=your_linkedin_client_id
# LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# GitHub API (Optional - for portfolio integration)
# Get from: https://github.com/settings/tokens
# GITHUB_TOKEN=your_github_personal_access_token

# =================================================================
# ANALYTICS & MONITORING
# =================================================================
# Google Analytics (Optional)
# GA_TRACKING_ID=your_google_analytics_id

# Sentry (Optional - for error tracking)
# Get from: https://sentry.io/
# SENTRY_DSN=your_sentry_dsn

# =================================================================
# DEVELOPMENT SETTINGS
# =================================================================
NODE_ENV=development
# Set to 'production' when deploying

# =================================================================
# RATE LIMITING & SECURITY
# =================================================================
# Rate limit settings (requests per minute)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100

# CORS settings
# CORS_ORIGIN=http://localhost:3000,https://yourfrontend.com

# =================================================================
# REDIS (Optional - for caching and sessions)
# =================================================================
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=your_redis_password
